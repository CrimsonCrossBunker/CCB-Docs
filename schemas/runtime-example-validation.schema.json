{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crimsoncrossbunker.github.io/CCB-Docs/schemas/runtime-example-validation.schema.json",
  "title": "CCB runtime example validation source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_repository",
    "source_commit",
    "pending_source_pr",
    "validator_paths",
    "examples"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_repository": {
      "const": "CrimsonCrossBunker/Cataclysm-Cleanwater-Bomb"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pending_source_pr": {
      "type": "string",
      "pattern": "^https://github\\.com/CrimsonCrossBunker/Cataclysm-Cleanwater-Bomb/pull/[1-9][0-9]*$"
    },
    "validator_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(src|tests)/[^/].*"
      }
    },
    "examples": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "contains": {
        "const": "ccb_lua_v5_example"
      },
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    }
  }
}

