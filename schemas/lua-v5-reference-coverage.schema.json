{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crimsoncrossbunker.github.io/CCB-Docs/schemas/lua-v5-reference-coverage-v1.json",
  "title": "CCB-Docs Lua v5 generated-reference coverage",
  "type": "object",
  "required": [
    "schema_version",
    "api_version",
    "generated_by",
    "source_repository",
    "source_commit",
    "pending_source_pr",
    "contract_sha256",
    "contract_public_symbols",
    "contract_documented_symbols",
    "contract_undocumented_symbols",
    "inventory_coverage_percent",
    "generated_reference_symbols",
    "generated_reference_coverage_percent",
    "production_published_coverage_percent",
    "publication_status",
    "sections",
    "generated_reference_pages",
    "generated_bilingual_pages",
    "symbols"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "api_version": { "const": 5 },
    "generated_by": { "type": "string", "minLength": 1 },
    "source_repository": { "type": "string", "format": "uri" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "pending_source_pr": { "type": "string", "format": "uri" },
    "contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contract_public_symbols": { "type": "integer", "minimum": 1 },
    "contract_documented_symbols": { "type": "integer", "minimum": 1 },
    "contract_undocumented_symbols": {
      "type": "object",
      "required": ["count", "ids"],
      "properties": {
        "count": { "const": 0 },
        "ids": { "type": "array", "maxItems": 0 }
      },
      "additionalProperties": false
    },
    "inventory_coverage_percent": { "const": 100.0 },
    "generated_reference_symbols": { "type": "integer", "minimum": 1 },
    "generated_reference_coverage_percent": { "const": 100.0 },
    "production_published_coverage_percent": { "const": 0.0 },
    "publication_status": { "const": "draft-pending-source-pr" },
    "sections": { "type": "object", "minProperties": 15 },
    "generated_reference_pages": { "type": "integer", "minimum": 1 },
    "generated_bilingual_pages": { "type": "integer", "minimum": 2 },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["documentation_id", "section", "page_id", "anchor", "paths"],
        "properties": {
          "documentation_id": { "type": "string", "pattern": "^api\\.lua\\.v5\\.generated\\." },
          "section": { "type": "string", "minLength": 1 },
          "page_id": { "type": "string", "pattern": "^api\\.lua\\.v5\\.reference\\." },
          "anchor": { "type": "string", "pattern": "^symbol-" },
          "paths": {
            "type": "object",
            "required": ["zh_CN", "en"],
            "properties": {
              "zh_CN": { "type": "string", "pattern": "^docs/zh_CN/.+\\.md$" },
              "en": { "type": "string", "pattern": "^docs/en/.+\\.md$" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
