{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crimsoncrossbunker.github.io/CCB-Docs/schemas/docs-catalog-v2.json",
  "title": "CCB-Docs catalog v2",
  "type": "object",
  "required": [ "schema_version", "site", "pages" ],
  "properties": {
    "schema_version": { "const": 2 },
    "site": {
      "type": "object",
      "required": [
        "default_language",
        "languages",
        "base_url",
        "documentation_repository",
        "source_repository",
        "source_branch"
      ],
      "properties": {
        "default_language": { "const": "zh_CN" },
        "languages": {
          "type": "array",
          "const": [ "zh_CN", "en" ]
        },
        "base_url": { "type": "string", "format": "uri" },
        "documentation_repository": { "type": "string", "format": "uri" },
        "source_repository": { "type": "string", "format": "uri" },
        "source_branch": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "allOf": [
          { "$ref": "page-metadata.schema.json" },
          {
            "type": "object",
            "required": [ "path", "translation_group", "nav" ],
            "properties": {
              "path": { "type": "string", "pattern": "^[^/].*\\.md$" },
              "translation_group": { "type": "string", "minLength": 1 },
              "nav": {
                "type": "object",
                "required": [ "section", "order" ],
                "properties": {
                  "section": { "type": "string", "minLength": 1 },
                  "order": { "type": "integer" }
                },
                "additionalProperties": false
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
